# Slack Socket Mode credentials
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODELS=gpt-5-mini

# Local Ollama (no API key). Pull configured models before starting the bot.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODELS=qwen3:8b

# Optional: automatically analyze allowlisted Slack messages and Huddle transcripts.
# Omit this to keep the per-source model dropdown.
AUTO_ANALYZE_MODEL=ollama/qwen3:8b

# Linear personal API key and target team UUID
LINEAR_API_KEY=lin_api_...
LINEAR_TEAM_ID=89a0d855-a923-442b-84ea-7dd901012197

# Comma-separated Slack channel IDs the bot may analyze. Empty allows DMs and mentions only.
ALLOWED_SLACK_CHANNEL_IDS=
PROPOSAL_STORE_PATH=.data/proposals.json

# Daily assignee digest (deterministic; no LLM calls)
DEADLINE_MONITOR_ENABLED=false
DEADLINE_MONITOR_INTERVAL_MINUTES=1440
DEADLINE_WARNING_DAYS=7,3,1,0
DEADLINE_NOTIFICATION_STORE_PATH=.data/deadline-notifications.json
